{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "mock": "tsx watch src/mock/middlewares.ts",
    "ng": "ng",
    "start": "ng serve ui",
    "build": "ng build --configuration=production",
    "lint": "ng lint",
    "sonar": "sonar-scanner",
    "test": "jest --coverage",
    "test-ci": "jest --coverage --runInBand --testResultsProcessor=jest-junit",
    "i18n:extract": "ngx-translate-extract --input src --output ./public/assets/i18n/{en,de}.json --sort -m --format json",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.4",
    "@angular/compiler": "^20.2.4",
    "@angular/core": "^20.2.4",
    "@angular/forms": "^20.2.4",
    "@angular/platform-browser": "^20.2.4",
    "@angular/router": "^20.2.4",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@payloadcms/live-preview": "^3.62.0",
    "@tailwindcss/postcss": "^4.1.12",
    "dompurify": "^3.3.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "subsink": "^1.0.2",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.2",
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.4",
    "@happy-dom/jest-environment": "^18.0.1",
    "@storybook/addon-a11y": "^9.1.4",
    "@storybook/addon-docs": "^9.1.4",
    "@storybook/addon-onboarding": "^9.1.4",
    "@storybook/angular": "^9.1.4",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/json-server": "^0.14.8",
    "@vendure/ngx-translate-extract": "^10.0.1",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "eslint-plugin-storybook": "^9.1.4",
    "jasmine-core": "~5.8.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^14.2.4",
    "json-server": "^0.17.4",
    "ng-mocks": "^14.13.5",
    "ngx-logger": "5.0.12",
    "sonarqube-scanner": "4.3.0",
    "storybook": "^9.1.4",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.34.1"
  },
  "jest": {
    "cacheDirectory": "/tmp/2mh/jest",
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.spec).[jt]s?(x)"
    ],
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setupJest.ts"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "testRunner": "jest-circus/runner",
    "roots": [
      "<rootDir>"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "testEnvironment": "@happy-dom/jest-environment",
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ]
  },
  "jest-junit": {
    "outputDirectory": "./coverage",
    "outputName": "testlog.xml"
  }
}
